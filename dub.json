{
	"name": "perfontain",
	"targetPath": "bin",
	"buildTypes": {
		"debug": {
			"buildOptions": [
				"debugMode"
			],
			"lflags": [
				"/LIBPATH:utils/deps/debug"
			]
		},
		"release-nobounds": {
			"preBuildCommands": [
				"python3 utils/pack.py || rem"
			],
			"lflags": [
				"/LIBPATH:utils/deps/release"
			]
		}
	},
	"dependencies": {
		"stb": ">=2.0.4",
		"utile": ">=2.9.6",
		"pegged": ">=0.4.8",
		"derelict-sdl2": ">=3.1.0-alpha.4",
		"bindbc-common": "~>1.0.5",
		"bindbc-loader": "~>1.1.5",

		"utile:zip": "*",
		"utile:sqlite": "*",
	},
	"subConfigurations": {
		"derelict-sdl2": "derelict-sdl2-static"
	},
	"stringImportPaths": [
		"source/perfontain/shader/resource"
	],
	"libs": [
		"sdl_x64",
		"bgfx_x64",
		"lispsm_x64",
		"nuklear_x64",
		"sdl_ttf_x64",
		"sdl_mixer_x64"
	],
	"dflags": [
		"-preview=in",
		"-P-Iutils/bgfx/deps/bx/include",
		"-P-Iutils/bgfx/deps/bgfx/include"
	],
	"buildRequirements": [
		"silenceDeprecations"
	],
	"dflags-ldc": [
		"-ffast-math"
	],
	"libs-linux": [
		"Xi",
		"X11",
		"Xext",
		"asound",
		"stdc++"
	],
	"libs-windows": [
		"gdi32",
		"imm32",
		"ole32",
		"winmm",
		"user32",
		"version",
		"oleaut32",
		"setupapi"
	],
	"lflags-linux": [
		"-s",
		"-Lutils/deps"
	],
	"lflags-windows": [
		"/LIBPATH:utils/deps"
	],
	"importPaths": [
		"utils/bgfx"
	]
}
